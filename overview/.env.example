# Copy to .env. Each site: Name|status URL (container name, port 8080)|link
# for its "Open dashboard" button (the gateway's /site/<id>, which also
# switches the selector)|optional own address for its "Own tab" link (that
# copy's own port, so routers can be open side by side); sites separated by
# commas.
SITES=Home|http://fwdash-home:8080|/site/home|http://192.168.23.70:8180/next,Just Because|http://fwdash-jb:8080|/site/jb|http://192.168.23.70:8181/next
PORT=8179
POLL_SECONDS=10
