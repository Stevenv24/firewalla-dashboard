# Copy to .env. Each site: Name|status URL (container name, port 8080)|link
# for its "Open dashboard" button (the gateway's /site/<id>, which also
# switches the selector); sites separated by commas.
SITES=Home|http://fwdash-home:8080|/site/home,Just Because|http://fwdash-jb:8080|/site/jb
PORT=8179
POLL_SECONDS=10
