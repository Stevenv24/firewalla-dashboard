# Copy this file to .env (same folder) if you need to change either value;
# compose.yaml reads it. Without it the defaults below are used.
# (Your network's own settings go in config/settings.env instead: see
# settings.env.example.)

# Container names start with this (two copies on one NAS need different ones).
CONTAINER_PREFIX=firewalla-dashboard
# The port the dashboard opens on: http://<NAS address>:<PORT>/next
PORT=8180
