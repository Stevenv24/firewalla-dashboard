# Not tracked by version history (this copy will be made public):
# - data, logs: each copy's own database, history and logs
# - config: each copy's own router key, known_hosts, MSP token, email
#   settings and Claude key (secret; never commit)
data/
logs/
config/
# - .env: this copy's own settings (see .env.example)
.env
*.db
*.db-shm
*.db-wal
__pycache__/
